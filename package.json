{
  "displayName": "Homebridge Samsung WindFree AC (vamm-fork)",
  "name": "@vamm-fork/homebridge-samsung-windfree-ac",
  "version": "2.2.0",
  "description": "Homebridge plugin for Samsung WindFree AC with support for OAuth2 (not required to change token everyday). Fork of https://github.com/qubiack/homebridge-samsung-windfree-ac/ with display, humidity, fan and auto-clean support.",
  "license": "Apache-2.0",
  "private": false,
  "homepage": "https://github.com/RJLino/homebridge-samsung-windfree-ac/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RJLino/homebridge-samsung-windfree-ac.git"
  },
  "bugs": {
    "url": "https://github.com/RJLino/homebridge-samsung-windfree-ac/issues"
  },
  "engines": {
    "node": "^18.17.0 || ^20.7.0 || ^22 || ^24",
    "homebridge": "^1.7.0 || ^2.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src/**.ts --max-warnings=0",
    "watch": "npm run build && npm link && nodemon",
